---
import BrandHead from './BrandHead.astro';

interface Props {
  title: string;
  description: string;
  themeColor?: string;
}
const { title, description, themeColor = '#121311' } = Astro.props;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="theme-color" content={themeColor} />
<title>{title}</title>
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
<meta name="twitter:card" content="summary_large_image" />
<BrandHead />
<link rel="icon" href="/brand/orange/favicon.svg" sizes="any" type="image/svg+xml" />
