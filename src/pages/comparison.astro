---
import { Content, frontmatter } from '../content/comparison.md';
import tools from '../content/comparison-tools.json';
import Site from '../layouts/Site.astro';
---

<Site title={`${frontmatter.title} | Code Mortis`} description={frontmatter.description}>
  <main id="main">
    <header class="page-width opener">
      <div class="pitch">
        <h1>Why choose<br /><em>Code Mortis?</em></h1>
        <p>See which change introduced a bug, how much code the review covered, and whether a later commit fixed it.</p>
      </div>
      <nav id="compare-tools" aria-label="Compare review tools">
        <p>Compare with</p>
        <ul class="engine-index">
          {tools.map(tool => (
            <li><a href={`#${tool.short.toLowerCase()}`}>{tool.name}<span aria-hidden="true">↓</span></a></li>
          ))}
        </ul>
      </nav>
    </header>

    <div class="feature-area">
      <div class="page-width">
        {tools.map(tool => (
          <section class="engine-features" aria-labelledby={tool.short.toLowerCase()}>
            <h2 id={tool.short.toLowerCase()}>{tool.short}</h2>
            <ul class="engine-index">
              <li>
                <h3>When to choose Code Mortis</h3>
                <p>{tool.mortis.text}</p>
                <div class="sources">{tool.mortis.links.map(link => <a class="text-link" href={link.href}>{link.label}</a>)}</div>
              </li>
              <li>
                <h3>Where {tool.short} fits</h3>
                <p>{tool.other.text}</p>
                <div class="sources">{tool.other.links.map(link => <a class="text-link" href={link.href}>{link.label}</a>)}</div>
              </li>
            </ul>
          </section>
        ))}
        <p class="origin">PR-Agent is the community-maintained project originally developed by Qodo. The Qodo comparison covers its current platform. <a class="text-link" href="https://github.com/The-PR-Agent/pr-agent#big-news-for-pr-agent">Project history</a></p>
      </div>
    </div>
    <Content />
  </main>
</Site>

<style>
  #compare-tools p { margin-bottom: .75rem; }
  #compare-tools li { padding: 0; }
  #compare-tools a { display: flex; justify-content: space-between; gap: 1rem; padding-block: .8rem; font-weight: 600; }
  #compare-tools span { color: var(--signal); }
  .feature-area section:first-child { border-top: 0; }
  .sources { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin-top: .75rem; }
  :global(.walkthrough li p) { margin-bottom: .65rem; }
  :global(.comparison-date) { padding-block: 1.5rem; font-size: .875rem; }
  .origin { padding-bottom: 2rem; font-size: .875rem; }
</style>
