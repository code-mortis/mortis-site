---
import '../../styles/landing.css';
import '../../styles/concepts.css';
import darkLogo from '../../assets/orange/raven-orange-dark.svg';
import lightLogo from '../../assets/orange/raven-orange-light.svg';
import RavenHunt from '../../components/RavenHunt.astro';
import ReviewCommands from '../../components/ReviewCommands';

export function getStaticPaths() {
  // These are design proposals; the production build keeps the chosen homepage.
  return import.meta.env.DEV ? ['night-watch', 'field-guide', 'diff-view'].map(direction => ({ params: { direction } })) : [];
}
const id = Astro.params.direction!;
const names = {'night-watch':'Night Watch', 'field-guide':'Field Guide', 'diff-view':'Diff View'} as const;
const field = id === 'field-guide', diff = id === 'diff-view';
const walkthrough = field;
const hero = id;
const logo = field ? lightLogo : darkLogo;
const actions = [
  ['Review a change', 'Choose the working tree, staged changes, a branch, or the whole repository.', 'mortis review --staged'],
  ['Scan a revision', 'Check dependencies, configuration, and exposed secrets. Assess potential issues against the source.', 'mortis scan --ref HEAD'],
  ['Verify a fix', 'Revisit a saved finding against a later commit and see whether the evidence still holds.', 'mortis verify --run RUN_ID --ref HEAD'],
];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><link rel="icon" href="/brand/orange/favicon.svg"/><title>{names[id as keyof typeof names]} · Code Mortis landing preview</title></head>
<body class:list={['landing',hero]}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="page-width mast">
    <a href="/" aria-label="Code Mortis home"><img src={logo.src} alt="Code Mortis" width="173" height="30"/></a>
    <nav aria-label="Main navigation"><a href="#features">Engine</a><a href="/comparison/">Compare</a><a href="/docs/">Docs</a></nav>
    <a class="mast-end" href="https://github.com/code-mortis/mortis-engine">GitHub ↗</a>
  </header>
  <main id="main">
    <section class="page-width opener">
      <div class="pitch">
        <h1>{field ? <>A field guide<br/>to <em>better code.</em></> : diff ? <>Read beyond<br/><em>the diff.</em></> : <>Find the bug.<br/><em>Show the line.</em></>}</h1>
        <p>{field ? 'Review Git changes with an eye for the details. Mortis links each finding to its source, so you can follow the evidence yourself.' : diff ? 'Choose a Git revision. Mortis reviews the change, checks the surrounding source, and gives you findings you can verify in your terminal.' : 'Code review that points to the source. Mortis checks your Git changes for bugs and lets you verify the fix with the AI model you choose.'}</p>
        <div class="hero-links"><a class="install-link" href="#install">Install the Engine <span aria-hidden="true">→</span></a><a class="text-link" href="#features">{field ? 'Follow a review' : diff ? 'Try a review scope' : 'Inspect a finding'}</a></div>
      </div>
      <div class="stage">
        {diff && <div class="terminal-title"><span>mortis-engine</span><code>review --staged</code></div>}
        <RavenHunt scene={hero}/>
      </div>
    </section>
    <div class="feature-area" id="features"><div class="page-width">
      {walkthrough ? <section class="walkthrough">
        <h2>Follow one bug<br/><em>through a review.</em></h2>
        <ol>
          <li><div><h3>Choose the change</h3><p>Start with the index. Preview the scope before any source goes to your provider.</p><code>mortis review --staged --preview</code></div></li>
          <li><div><h3>Read the evidence</h3><p>In this example, 21 items at 10 per page need three pages. Integer division counts only two.</p><code>pagination.py:18 · total // page_size</code></div></li>
          <li><div><h3>Check the fix</h3><p>Commit the correction, then verify the original finding against the new revision.</p><code>mortis verify --run RUN_ID --ref HEAD</code></div></li>
        </ol>
      </section> : diff ? <section class="demo-row"><div><h2>Start with<br/>your changes.</h2><p>Switch scopes to see the command you’d run inside your repository.</p></div><ReviewCommands client:load /></section> :
      <section class="evidence">
        <div><h2>One line.<br/><em>One missing page.</em></h2><p>A finding should give you enough evidence to decide whether to change the code.</p></div>
        <figure class="excerpt"><figcaption><strong>Example finding</strong><code>pagination.py:18</code></figcaption><pre><code><span>18</span>  pages = total // page_size</code></pre><h3>The last item disappears</h3><p>21 items. 10 per page. The code returns two pages, leaving the last item out.</p></figure>
      </section>}
      {diff && <section class="patch"><div><h2>The finding,<br/>in context.</h2><p>Example: the last page disappears when the item count isn’t a multiple of the page size.</p></div><figure class="excerpt"><figcaption><strong>Illustrative fix</strong><code>pagination.py</code></figcaption><pre><code>- pages = total // page_size{'\n'}+ pages = -(-total // page_size)</code></pre><p>With 21 items and a page size of 10, the corrected count is three.</p></figure></section>}
        <section class="capabilities"><h2>{field ? 'Inside the Engine' : diff ? 'After the first run' : 'What can you check?'}</h2>
          <div>{actions.map(([name,detail,command],i) => <details name="capability" open={i === (diff ? 2 : field ? 1 : 0)}><summary>{name}</summary><p>{detail}</p><code>{command}</code></details>)}</div>
        </section>
    </div></div>
    <section class="install-band" id="install"><div class="page-width"><div><h2>Run your first review.</h2><p>Install the CLI and connect your AI provider. Eligible source and diffs go to that connection; run history stays on your machine.</p></div><div><pre><code>uv tool install mortis-engine{'\n'}mortis connect{'\n'}mortis review --progress</code></pre><a class="text-link" href="/docs/engine/cli/">CLI guide</a><a class="text-link" href="/docs/engine/python/">Python library guide</a></div></div></section>
  </main>
  <footer class="page-width"><a href="/"><img src={logo.src} width="140" height="24" alt="Code Mortis"/></a><a href="/docs/">Documentation</a></footer>
</body></html>
