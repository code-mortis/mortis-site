---
import '../styles/review-desk.css';
import DeskMasthead from '../components/DeskMasthead.astro';
import SiteHead from '../components/SiteHead.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Code Mortis | Code review with evidence.',
  description = 'Review pull requests, investigate repository security, and verify findings against the source with the Code Mortis App, GitHub Action, or standalone Engine.',
} = Astro.props;
---
<!doctype html>
<html lang="en" data-type="software">
  <head>
    <SiteHead title={title} description={description} themeColor="#fafaf8" />
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="software" />
  </head>
  <body class="mock review-desk">
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav-ground">
      <DeskMasthead />
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div class="shell final">
        <div><p class="kicker">Start with your repository</p><h2>Open your own workspace.</h2></div>
        <div class="closing-links">
          <a href="/docs/engine/cli/">Install the Engine ↗</a>
          <a href="/docs/action/setup/">Add the Action ↗</a>
          <a href="/docs/app/deployment/">Deploy the App ↗</a>
        </div>
      </div>
      <nav class="site-links shell" aria-label="Site links">
        <a href="/docs/">Documentation</a>
        <a href="/comparison/">Compare tools</a>
        <a href="https://github.com/code-mortis/mortis-engine">GitHub ↗</a>
      </nav>
    </footer>
    <dialog id="capture-dialog" aria-labelledby="capture-title">
      <div class="modal-wrap">
        <header><h2 id="capture-title">App capture</h2><button type="button" autofocus>Close ×</button></header>
        <p class="pan-hint">Swipe across the image to inspect the details.</p>
        <div class="modal-image"><img alt="" /></div>
      </div>
    </dialog>
    <script>import '../components/review-desk/interactions';</script>
  </body>
</html>
