---
import { setups } from './content';
---
<section class="machine" id="setup" aria-label="Ways to use Mortis">
  <div class="shell machine-layout" data-switch>
    <div class="machine-heading"><p class="kicker">Mortis Engine</p><h1>Code review<br/>on your stack.</h1><p>Review a change with your own model. Run the engine locally, wire it into GitHub, or give your team a shared App.</p></div>
    <div class="machine-art" aria-hidden="true"><img src="/engine-layers.webp" width="1000" height="1000" alt="" fetchpriority="high"/></div>
    <div role="tablist" class="machine-tabs" aria-label="Choose a setup">{setups.map((s,i)=><button role="tab" id={`setup-tab-${s.key}`} aria-controls={`setup-${s.key}`} aria-selected={i===0} tabindex={i ? -1 : 0}><span class="machine-symbol" aria-hidden="true">{['>_','⑂','▦'][i]}</span><span>{s.label}</span><small>{s.context}</small></button>)}</div>
    {setups.map((s,i)=><div class="machine-instructions" id={`setup-${s.key}`} role="tabpanel" aria-labelledby={`setup-tab-${s.key}`} hidden={i!==0}><p class="micro">{s.file}</p><h2>{s.title}</h2><div class="code-sample"><pre><code>{s.code}</code></pre><button data-copy type="button" aria-label={`Copy ${s.label} example`}>Copy</button></div><div class="guide-links"><a href={s.href}>{s.link} ↗</a><a href={s.extraHref}>{s.extra}</a></div></div>)}
  </div>
</section>
