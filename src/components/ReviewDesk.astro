---
import BranchStudy from './hero-studies/BranchStudy.astro';
import HeroMotionToggle from './HeroMotionToggle.astro';
import ReviewEvidence from './ReviewEvidence.astro';
import Tour from './review-desk/Tour.astro';
import Chapters from './review-desk/Chapters.astro';
import Finding from './review-desk/Finding.astro';
import Setup from './review-desk/Setup.astro';
---

<section class="desk-hero woven-hero">
  <div class="hero-art" aria-hidden="true">
    <BranchStudy variant="telar" />
    <BranchStudy variant="telar" compact />
  </div>
  <div class="desk-content">
    <h1>Every finding,<br/><em>down to the line.</em></h1>
    <p>Review pull requests, trace a dependency, and inspect the source behind a security report in one self-hosted workspace.</p>
    <div class="actions">
      <a class="primary" href="/docs/app/deployment/">Deploy Code Mortis</a>
      <a class="secondary" href="#tour">Open sample review <span aria-hidden="true">↓</span></a>
    </div>
  </div>
  <HeroMotionToggle />
</section>

<!-- Keep bookmarks from the original homepage pointing to the corresponding sections. -->
<div id="features"><Tour lead /></div>
<Chapters chapter="agents" />
<Chapters chapter="security" />
<div id="workflow">
  <div id="example-finding">
    <Finding><ReviewEvidence slot="evidence" /></Finding>
  </div>
</div>
<div id="inside-the-engine">
  <div id="engine"></div>
  <div id="engine-features-title"></div>
  <div id="install"></div>
  <div id="get-started"></div>
  <Setup />
</div>
<div class="review-settings-band">
  <Chapters chapter="controls" />
</div>
<Chapters chapter="questions" />

<style is:global>
  .desk-hero.woven-hero { padding-block: clamp(72px,6vw,102px) clamp(83px,7vw,118px); }
  .woven-hero .hero-art { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  @media (max-width: 740px) {
    .desk-hero.woven-hero { padding: 69px max(24px, 7vw) 84px; }
  }
</style>
