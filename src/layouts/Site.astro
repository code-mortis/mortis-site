---
import '../styles/landing.css';
import '../styles/night-guide.css';
import SiteNav from '../components/SiteNav.astro';
import logo from '../assets/orange/raven-orange-dark.svg';
import SiteHead from '../components/SiteHead.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const repository = 'https://github.com/code-mortis/mortis-engine';
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead {title} {description} themeColor="#191b18" />
  </head>
  <body class="landing">
    <a class="skip-link" href="#main">Skip to content</a>
    <header><SiteNav /></header>
    <slot />
    <footer class="page-width"><a class="wordmark" href="/"><img src={logo.src} width="142" height="24" alt="Code Mortis" /></a><a href="/docs/">Documentation</a><a href={repository}>GitHub ↗</a></footer>
  </body>
</html>
