---
import '../styles/landing.css';
import logo from '../assets/orange/raven-orange-dark.svg';
import BrandHead from '../components/BrandHead.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const repository = 'https://github.com/code-mortis/mortis-engine';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121311" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <BrandHead />
    <link rel="icon" href="/brand/orange/favicon.svg" sizes="any" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="wrap site-header">
      <a class="wordmark" href="/" aria-label="Code Mortis home"><img src={logo.src} width="165" height="28" alt="Code Mortis" /></a>
      <nav aria-label="Main navigation">
        <a href="/#engine">Engine</a>
        <a href="/#workflow">Workflow</a>
        <a href="/comparison/" aria-current={Astro.url.pathname.replace(/\/$/, '') === '/comparison' ? 'page' : undefined}>Compare</a>
        <a href="/docs/">Docs</a>
      </nav>
      <a class="repo-link" href={repository}>GitHub <span aria-hidden="true">↗</span></a>
    </header>
    <slot />
    <footer class="wrap"><a class="wordmark" href="/"><img src={logo.src} width="142" height="24" alt="Code Mortis" /></a><a href="/docs/">Documentation</a><a href={repository}>GitHub ↗</a></footer>
  </body>
</html>

<style>
  nav a[aria-current="page"] { color: var(--ink); text-decoration: underline; text-underline-offset: .35em; }
  @media (max-width: 420px) {
    .site-header { grid-template-columns: 1fr; gap: 6px; padding-block: 12px; }
    .site-header nav { justify-content: space-between; }
  }
</style>
