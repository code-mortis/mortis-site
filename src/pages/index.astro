---
import ReviewCommands from '../components/ReviewCommands';
import '../styles/landing.css';

const repository = 'https://github.com/code-mortis/mortis-engine';
const features = [
  ['Review at any scope', 'Working tree, staged changes, a branch, or the full repository. Preview selected files and exclusions before making an AI request.'],
  ['Findings with evidence', 'Candidates are assessed against source pinned to the reviewed Git revisions. Inspect the evidence, then verify a fix against a later revision.'],
  ['Security beyond the diff', 'Combine Trivy dependency, configuration, and secret checks with AI semantic analysis. Security scans require Trivy.'],
  ['Your choice of model', 'Connect OpenAI, Anthropic, Amazon Bedrock, Gemini, OpenRouter, and compatible endpoints with your own credentials.'],
  ['Results that stay useful', 'Keep local run history, export Markdown and JSON reports, and record finding decisions with an audit trail.'],
  ['Pick up where you left off', 'Resume interrupted runs and retry failed assessments. Control effort, concurrency, and token budgets for each run.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Code Mortis brings evidence-based code review and repository security to your terminal. Explore the Engine, with the App and GitHub Action coming soon." />
    <meta name="theme-color" content="#141618" />
    <title>Code Mortis | Code review, grounded in your code.</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Code Mortis home"><svg width="25" height="25" viewBox="0 0 25 25" fill="none" aria-hidden="true"><path d="M3 20V5l9.5 10L22 5v15M3 5h6m7 0h6" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>Code Mortis<span class="wordmark-period">.</span></a>
        <nav aria-label="Main navigation"><a href="#engine">Engine</a><a href="/docs/">Documentation</a><a href={repository}>GitHub <span aria-hidden="true">↗</span></a></nav>
      </header>

      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <h1 id="hero-title">Code review,<br />grounded in <span>your code.</span></h1>
          <div class="hero-bottom">
            <p>Find the issues that deserve a closer look.<br class="desktop-break" /> Code Mortis reviews your changes, checks the evidence, and helps you follow through.</p>
            <a class="button" href="#get-started">Get the Engine <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          </div>
        </section>

        <section id="engine" class="engine-section" aria-labelledby="engine-title">
          <div class="section-heading"><h2 id="engine-title">The Engine.<br /><span>Start with your code.</span></h2><a href="https://pypi.org/project/mortis-engine/" class="status available"><span class="status-dot" aria-hidden="true"></span>Available on PyPI</a></div>
          <p class="section-intro">Code review and repository security as a standalone CLI or a Python library. Work with local Git changes and the AI connection you choose.</p>
          <ReviewCommands client:load />
          <div class="feature-list">
            {features.map(([title, description]) => <article class="feature"><h3>{title}</h3><p>{description}</p></article>)}
          </div>
          <p class="source-note">Eligible source and diffs are sent to your selected AI connection. Run history is stored locally.</p>
        </section>

        <section class="get-started" id="get-started" aria-labelledby="get-started-title">
          <div><h2 id="get-started-title">Make your next<br />review a Mortis review.</h2><p>Use the CLI in your terminal, or add the Engine to your Python project.</p><p>Requires Git and Python 3.13–3.15.</p><a class="text-link" href="https://pypi.org/project/mortis-engine/">View the package on PyPI <span aria-hidden="true">↗</span></a></div>
          <div class="install">
            <h3>Install the CLI</h3>
            <pre aria-label="Install and run the Mortis CLI"><code>uv tool install mortis-engine{'\n'}mortis connect{'\n'}mortis review --progress</code></pre>
            <h3>Use the Python library</h3>
            <pre aria-label="Install the Mortis Python library"><code>pip install mortis-engine</code></pre>
            <p>Or add it to a uv project: <code>uv add mortis-engine</code></p>
            <pre class="python-example" aria-label="Preview review scope with the Python library"><code><span class="code-comment"># Preview scope without making an AI request</span>{'\n'}from mortis_engine.review import preview_local{'\n\n'}plan = preview_local(".", mode="all"){'\n'}print(plan["totals"])</code></pre>
          </div>
        </section>

        <section class="coming-next" aria-labelledby="coming-next-title">
          <h2 id="coming-next-title">More ways to use Mortis.</h2>
          <div class="upcoming-product"><div><h3>The App</h3><p>A dedicated home for Code Mortis.</p></div><span class="status">Coming soon</span></div>
          <div class="upcoming-product"><div><h3>GitHub Action</h3><p>Code Mortis in your GitHub workflow.</p></div><span class="status">Coming soon</span></div>
        </section>
      </main>

      <footer><a class="footer-name" href="/">Code Mortis.</a><span>A closer look at your code.</span><a href="/docs/">Documentation</a><a href={repository}>GitHub <span aria-hidden="true">↗</span></a></footer>
    </div>
  </body>
</html>
