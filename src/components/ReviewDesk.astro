---
import ReviewBranches from './ReviewBranches.astro';
import ReviewEvidence from './ReviewEvidence.astro';
import Tour from './mockups/Tour.astro';
import Chapters from './mockups/Chapters.astro';
import Finding from './mockups/Finding.astro';
import Setup from './mockups/Setup.astro';
---

<section class="desk-hero" data-enter>
  <ReviewBranches />
  <div class="desk-content">
    <h1>Every finding,<br/><em>down to the line.</em></h1>
    <p>Review pull requests, trace a dependency, and inspect the source behind a security report in one self-hosted workspace.</p>
    <div class="actions">
      <a class="primary" href="/docs/app/deployment/">Deploy Code Mortis</a>
      <a class="secondary" href="#tour">Open sample review <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<!-- Keep bookmarks from the original homepage pointing to the corresponding sections. -->
<div id="features"><Tour lead /></div>
<Chapters chapter="agents" />
<Chapters chapter="security" />
<div id="workflow">
  <div id="example-finding">
    <Finding><ReviewEvidence slot="evidence" /></Finding>
  </div>
</div>
<div id="inside-the-engine">
  <div id="engine"></div>
  <div id="engine-features-title"></div>
  <div id="install"></div>
  <div id="get-started"></div>
  <Setup />
</div>
<div class="review-settings-band">
  <Chapters chapter="controls" />
</div>
<Chapters chapter="questions" />
