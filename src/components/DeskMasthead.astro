---
import { Icon } from '@astrojs/starlight/components';
import raven from '../assets/orange/raven-orange.svg';

const path = Astro.url.pathname.replace(/\/$/, '');
const home = path === '' ? '' : '/';
---
<div class="desk-mast mast shell">
  <a class="brand" href="/" aria-label="Code Mortis home">
    <img src={raven.src} width="34" height="28" alt="" />
    <span>Code Mortis</span>
  </a>
  <nav aria-label="Main navigation">
    <a href={home + '#tour'}>Product</a>
    <a href={home + '#setup'}>Installation</a>
    <a href={home + '#agents'}>MCP</a>
    <a href="/comparison/" aria-current={path === '/comparison' ? 'page' : undefined}>Compare</a>
    <a class="docs-link" href="/docs/" aria-current={path === '/docs' ? 'page' : path.startsWith('/docs/') ? 'location' : undefined}>Docs</a>
  </nav>
  <slot>
    <a class="compare" href="https://github.com/code-mortis">
      <Icon name="github" size="18px" aria-hidden="true" />GitHub
    </a>
  </slot>
</div>

<style>
  .desk-mast { width: calc(100% - clamp(44px,10vw,168px)); max-width: 1340px; margin-inline: auto; display: flex; align-items: center; min-height: 72px; gap: 45px; color: var(--sl-color-white, #202128); font: 550 14px/1.5 "Mortis Inter", Arial, sans-serif; }
  .desk-mast a { color: inherit; text-decoration: none; }
  .desk-mast a:hover, .desk-mast [aria-current] { text-decoration: underline; text-underline-offset: 5px; }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: .35em;
    flex: none;
    font-size: 1.375rem;
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -.02em;
    white-space: nowrap;
  }
  .brand img { width: 1.55em; height: auto; display: block; }
  nav { display: flex; gap: 30px; margin-inline: auto; }
  .compare { display: inline-flex; align-items: center; gap: 7px; padding: 7px 15px; border: 1px solid #d3d5d4; border-radius: 22px; }
  .desk-mast .compare:hover { border-color: #797d81; text-decoration: none; }
  @media(max-width:960px) { .desk-mast { gap: 24px; } nav { gap: 20px; } }
  @media(max-width:740px) {
    .desk-mast { width: calc(100% - 36px); min-height: 60px; gap: 14px; }
    .brand { margin-right: auto; font-size: 1.0625rem; }
    nav { display: none; }
    nav:has(+ .compare) { display: block; margin: 0; }
    nav a:not(.docs-link) { display: none; }
    .desk-mast nav + .compare { margin-left: 0; }
    .compare { font-size: 12px; }
  }
</style>
