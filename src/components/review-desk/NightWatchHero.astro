---
import raven from '../../assets/orange/raven-orange.svg';

// Typeset the same invoice boundary from the sample review into the bird.
const source = [
  'for invoice in invoices:',
  '- if invoice.due_date < period_end:',
  '+ if invoice.due_date <= period_end:',
  '    queue_reminder(invoice)',
];
---

<section class="night-watch" aria-labelledby="night-watch-title">
  <div class="print" aria-hidden="true">
    <svg viewBox="0 0 1000 300" focusable="false">
      <defs>
        <pattern id="night-source" patternUnits="userSpaceOnUse" x="300" width="400" height="38">
          {source.map((line, index) => (
            <text x={-index * 13} y={8 + index * 9.5}>{(line + '   ').repeat(4)}</text>
          ))}
        </pattern>
        <mask id="night-type" x="0" y="0" width="1000" height="300" maskUnits="userSpaceOnUse">
          <rect width="1000" height="300" fill="url(#night-source)" />
        </mask>
        <linearGradient id="night-ink" x1="0" y1="1" x2="1" y2="0" gradientUnits="objectBoundingBox">
          <stop stop-color="#eb562e" />
          <stop offset=".46" stop-color="#ff7946" />
          <stop offset=".76" stop-color="#ff9a56" />
          <stop offset="1" stop-color="#ffd195" />
        </linearGradient>
        <mask id="night-raven" x="300" y="0" width="400" height="300" maskUnits="userSpaceOnUse" style="mask-type:alpha">
          <image href={raven.src} x="319" y="0" width="362" height="300" />
        </mask>
        <linearGradient id="night-underprint" gradientUnits="userSpaceOnUse" x1="350" y1="244" x2="616" y2="48">
          <stop stop-color="#653321" />
          <stop offset=".62" stop-color="#91482b" />
          <stop offset="1" stop-color="#b4693d" />
        </linearGradient>
        <radialGradient id="night-field">
          <stop stop-color="#ab7652" stop-opacity=".65" />
          <stop offset=".55" stop-color="#89684c" stop-opacity=".47" />
          <stop offset="1" stop-color="#89684c" stop-opacity="0" />
        </radialGradient>
        <pattern id="night-dots" patternUnits="userSpaceOnUse" width="12" height="8">
          <path d="M0 5h1.2m4.8-4h1.2" stroke="white" stroke-width=".9" />
        </pattern>
        <mask id="night-screen" x="0" y="0" width="1000" height="300" maskUnits="userSpaceOnUse">
          <rect width="1000" height="300" fill="url(#night-dots)" />
        </mask>
      </defs>
      <rect width="1000" height="300" fill="url(#night-field)" mask="url(#night-screen)" />
      <g mask="url(#night-raven)">
        <rect x="319" width="362" height="300" fill="url(#night-underprint)" />
        <rect x="319" width="362" height="300" fill="url(#night-ink)" mask="url(#night-type)" />
      </g>
    </svg>
  </div>
  <div class="watch-copy">
    <h1 id="night-watch-title">Code review with <em>receipts.</em></h1>
    <p>Trace pull request findings and security reports back to the source in one self-hosted workspace.</p>
    <div class="watch-links">
      <a class="deploy" href="/docs/app/deployment/">Deploy Code Mortis</a>
      <a class="sample" href="#tour">
        Open sample review
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 2.5v10m-4-4L8 12.5l4-4" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .night-watch {
    min-block-size: calc(100vh - var(--mast-height) - 1px);
    min-block-size: calc(100dvh - var(--mast-height) - 1px);
    display: grid;
    align-content: center;
    justify-items: center;
    row-gap: clamp(18px, 3.2svh, 36px);
    padding: clamp(26px, 5svh, 68px) 22px;
    box-sizing: border-box;
    overflow: clip;
    text-align: center;
    color: #f8f3e9;
    background: #171916;
  }
  .night-watch ::selection { color: #171916; background: #ff956e; }
  .print {
    width: 100%;
    min-width: 0;
    height: clamp(142px, 34svh, 345px);
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .print svg { height: 100%; width: auto; flex: none; }
  .print text { font: 600 8.5px ui-monospace, monospace; fill: white; white-space: pre; }
  .watch-copy {
    width: min(100%, 1140px);
    display: grid;
    justify-items: center;
  }
  .night-watch h1 {
    margin: 0;
    color: inherit;
    font: 520 clamp(46px, 6.3vw, 96px)/1.02 "Mortis Inter", Arial, sans-serif;
    letter-spacing: -.04em;
    text-wrap: balance;
  }
  .night-watch h1 em { font: italic 400 1.07em/.95 Georgia, serif; color: #fac5a7; }
  .night-watch p {
    max-width: 47ch;
    margin: clamp(16px, 2svh, 22px) 0 0;
    font-size: clamp(16px, 1.35vw, 20px);
    line-height: 1.5;
    color: #c9c8ba;
    text-wrap: pretty;
  }
  .watch-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 25px;
    margin-top: clamp(21px, 3svh, 36px);
  }
  .watch-links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 620;
    transition: transform .18s, background-color .18s;
  }
  .watch-links .deploy { padding: 12px 22px; border-radius: 4px; background: #ff8456; color: #1e1915; }
  .watch-links .sample { gap: 8px; color: #ede9de; }
  .watch-links .deploy:hover { background: #ffaa80; transform: translateY(-2px); }
  .watch-links .deploy:active { transform: translateY(1px); }
  .watch-links .sample:hover { text-decoration: underline; text-underline-offset: 5px; }
  .watch-links a:focus-visible { outline: 2px solid #ffc09e; outline-offset: 5px; }
  @media (max-width: 620px) {
    .print { height: min(30svh, 61vw); }
    .night-watch h1 { max-width: 13ch; }
    .night-watch p { max-width: 36ch; }
  }
  @media (max-width: 378px) {
    .watch-links { flex-direction: column; gap: 2px; margin-top: 16px; }
  }
  @media (max-width: 480px) and (max-height: 650px) {
    .night-watch { padding-block: 16px; }
    .print { height: min(25svh, 56vw); }
  }
  @media (max-height: 480px) and (min-width: 600px) {
    .night-watch { padding-block: 14px; row-gap: 8px; }
    .print { height: 22svh; }
    .night-watch h1 { max-width: none; font-size: clamp(36px, 5vw, 56px); }
    .night-watch p { max-width: 65ch; margin-top: 8px; font-size: 15px; }
    .watch-links { margin-top: 10px; }
  }
</style>
