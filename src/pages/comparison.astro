---
import { Content, frontmatter } from '../content/comparison.md';
import tools from '../content/comparison-tools.json';
import Site from '../layouts/Site.astro';

const attributionTest = 'https://github.com/code-mortis/mortis-engine/blob/v0.1.0/tests/review/test_attribution.py#L48-L70';
---

<Site title={`${frontmatter.title} | Code Mortis`} description={frontmatter.description}>
  <main class="wrap compare" id="main">
    <header class="intro">
      <div>
        <h1>Why choose<br /><span class="heading-accent">Code Mortis?</span></h1>
        <p class="lead">See which change introduced a bug, how much code the review covered, and whether a later commit fixed it.</p>
        <a class="button" href="#compare-tools">Compare tools <span aria-hidden="true">↓</span></a>
      </div>
      <figure class="example">
        <figcaption><span>Branch attribution</span><code>caller.py</code></figcaption>
        <div class="revision"><span>Merge base</span><code>inverse(<b>1</b>)</code></div>
        <div class="revision"><span>Branch head</span><code>inverse(<b>0</b>)</code></div>
        <div class="explanation">
          <h3>The caller introduced the bug.</h3>
          <p>The division stayed the same. This branch passed zero for the first time.</p>
          <a href={attributionTest}>View the engine test</a>
        </div>
      </figure>
    </header>

    <section class="matchups" id="compare-tools" aria-labelledby="compare-title">
      <h2 id="compare-title">Compare review tools</h2>
      <fieldset>
        <legend class="sr-only">Choose a tool to compare with Code Mortis</legend>
        {tools.map((tool, i) => (
          <Fragment>
            <input class="sr-only" type="radio" name="alternative" id={`choose-${i}`} checked={i === 0} />
            <label for={`choose-${i}`}>{tool.short}</label>
            <div class="pair">
              <section class="mortis">
                <h3>When to choose Code Mortis</h3>
                <p>{tool.mortis.text}</p>
                <div class="sources">{tool.mortis.links.map(link => <a href={link.href}>{link.label}</a>)}</div>
              </section>
              <section>
                <h3>Where {tool.name} fits</h3>
                <p>{tool.other.text}</p>
                <div class="sources">{tool.other.links.map(link => <a href={link.href}>{link.label}</a>)}</div>
              </section>
            </div>
          </Fragment>
        ))}
      </fieldset>
      <p class="origin">PR-Agent is the community-maintained project originally developed by Qodo. The Qodo comparison covers its current platform. <a href="https://github.com/The-PR-Agent/pr-agent#big-news-for-pr-agent">Project history</a></p>
    </section>

    <article class="evidence"><Content /></article>
  </main>
</Site>

<style>
  .intro { display: grid; grid-template-columns: 1fr minmax(0, .85fr); gap: 8%; align-items: center; padding-block: clamp(3rem, 6vw, 6rem); }
  .intro > div > p { max-width: 44ch; margin-block: 1.2rem 1.65rem; }
  .example { border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
  .example figcaption, .revision { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
  .example figcaption { padding: .85rem 1.4rem; border-bottom: 1px solid var(--line); font-size: .9rem; font-weight: 650; }
  .example figcaption code, .revision span { color: var(--muted); font-size: .8rem; }
  .revision { padding: .3rem 1.4rem; }
  .revision:first-of-type { margin-top: .85rem; }
  .revision code { font-size: 1.15rem; }
  .revision b { font-weight: 500; }
  .revision + .revision b { color: var(--accent); }
  .explanation { border-top: 1px solid var(--line); margin-top: .85rem; padding: 1rem 1.4rem 1.25rem; }
  .explanation p { max-width: 44ch; margin: .3rem 0 .65rem; }
  .explanation a, .sources a, .origin a, .evidence :global(a) { text-decoration: underline; text-decoration-color: var(--muted); text-underline-offset: .22em; }
  .explanation a, .sources, .origin { font-size: .85rem; }
  .matchups { border-top: 1px solid var(--line); padding-block: clamp(2rem, 4vw, 4rem); }
  fieldset { padding: 0; margin: 1.5rem 0 0; border: 0; min-width: 0; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  label { grid-row: 1; cursor: pointer; text-align: center; padding: .75rem .25rem; border-bottom: 2px solid var(--line); color: var(--muted); font-weight: 650; }
  label:hover { color: var(--ink); background: var(--surface); }
  input:checked + label { color: var(--accent); border-color: var(--accent); }
  input:focus-visible + label { outline: 2px solid var(--accent); outline-offset: -3px; }
  .pair { grid-column: 1 / -1; grid-row: 2; display: none; border-bottom: 1px solid var(--line); }
  input:checked + label + .pair { display: grid; grid-template-columns: 1fr 1fr; }
  .pair section { padding: clamp(1.25rem, 2.5vw, 2rem); }
  .pair .mortis { background: var(--surface); }
  .pair h3 { font-size: clamp(1.2rem, 1.8vw, 1.5rem); }
  .pair p { max-width: 55ch; margin: .7rem 0 1rem; }
  .sources { display: flex; flex-wrap: wrap; gap: .4rem 1rem; }
  .origin { margin-top: .9rem; max-width: 100ch; }
  .evidence :global(section) { border-top: 1px solid var(--line); padding-block: clamp(2rem, 4vw, 4rem); display: grid; grid-template-columns: minmax(12rem,.65fr) minmax(0,1.35fr); column-gap: 7%; }
  .evidence :global(h2) { grid-column: 1; grid-row: span 2; text-wrap: balance; }
  .evidence :global(h3), .evidence :global(p), .evidence :global(pre) { grid-column: 2; max-width: 72ch; }
  .evidence :global(p) { margin-block: .5rem 1.6rem; }
  .evidence :global(pre) { padding: 1rem; border-radius: 5px; margin-bottom: 1rem; }
  .evidence :global(em) { color: var(--muted); font-family: inherit; font-size: .85rem; }
  @media (max-width: 700px) {
    .intro { grid-template-columns: 1fr; gap: 2rem; }
    .intro > div > p { max-width: 48ch; }
    input:checked + label + .pair { grid-template-columns: 1fr; }
    .evidence :global(section) { display: block; }
    .evidence :global(h2) { margin-bottom: 1.4rem; }
  }
</style>
