---
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
---

<figure class="doc-capture">
  <a href={image.src} title="Open full-size capture">
    <img src={image.src} width={image.width} height={image.height} alt={alt} loading="lazy" decoding="async" />
  </a>
</figure>

<style>
  .doc-capture {
    width: 100%;
    margin-inline: 0;
  }
  a, img { display: block; }
  img { width: 100%; height: auto; border-radius: .5rem; }
</style>
