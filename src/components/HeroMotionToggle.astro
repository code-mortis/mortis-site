---
interface Props {
  pauseLabel?: string;
  playLabel?: string;
}
const { pauseLabel = 'Pause animation', playLabel = 'Play animation' } = Astro.props;
---
<button type="button" class="hero-playback" hidden data-pause={pauseLabel} data-play={playLabel} aria-label={pauseLabel} title={pauseLabel}>
  <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
    <path class="pause" d="M7 5v10m6-10v10" />
    <path class="play" d="m7 4 8 6-8 6z" />
  </svg>
</button>
<style>
  :global(.mock) .hero-playback { display: grid; place-items: center; width: 40px; height: 40px; padding: 10px; border: 1px solid #d6d6cf; border-radius: 50%; background: var(--paper); }
  :global(.desk-hero) > .hero-playback { position: absolute; bottom: 10px; right: clamp(12px, 2vw, 32px); }
  :global(.mock) .hero-playback:hover { background: #e9e9e2; }
  .hero-playback svg { width: 18px; }
  .play, [data-paused] .pause { display: none; }
  [data-paused] .play { display: block; }
</style>
<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.hero-playback')) {
    const drawings = button.closest('main')!.querySelectorAll<SVGSVGElement>('.study-art');
    const visible = new Set<SVGSVGElement>();
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = reduced.matches;

    function sync() {
      for (const drawing of drawings) {
        if (!paused && !document.hidden && visible.has(drawing)) drawing.unpauseAnimations();
        else drawing.pauseAnimations();
      }
      const label = paused ? button.dataset.play! : button.dataset.pause!;
      button.setAttribute('aria-label', label);
      button.title = label;
      button.toggleAttribute('data-paused', paused);
    }
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        const drawing = entry.target as SVGSVGElement;
        if (entry.isIntersecting) visible.add(drawing);
        else visible.delete(drawing);
      }
      sync();
    });
    for (const drawing of drawings) {
      drawing.pauseAnimations();
      for (const animation of drawing.querySelectorAll<SVGAnimationElement>('[begin="indefinite"]')) {
        animation.beginElement();
      }
      observer.observe(drawing);
    }
    button.addEventListener('click', () => { paused = !paused; sync(); });
    reduced.addEventListener('change', () => { paused = reduced.matches; sync(); });
    document.addEventListener('visibilitychange', sync);
    sync();
    button.hidden = false;
  }
</script>
