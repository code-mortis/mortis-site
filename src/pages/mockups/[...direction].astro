---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import ReviewDesk from '../../components/ReviewDesk.astro';
import ravenFlight from '../../components/mockups/art/raven-flight.webp';
import EngineBench from '../../components/mockups/EngineBench.astro';
import { directions } from '../../components/mockups/content';
import Setup from '../../components/mockups/Setup.astro';
import Tour from '../../components/mockups/Tour.astro';
import Finding from '../../components/mockups/Finding.astro';
import Chapters from '../../components/mockups/Chapters.astro';

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return [undefined, ...directions.map(d => d.slug)].map(direction => ({ params: { direction } }));
}
const id = Astro.params.direction;
const current = directions.find(d => d.slug === id);
const field = id === 'field-notes', desk = id === 'review-desk', bench = id === 'workbench';
const previews = import.meta.glob<string>('../../components/mockups/previews/*.webp', {eager: true, query: '?url', import: 'default'});
---
<MarketingLayout direction={current} preview>
  {!current ? <div class="shell chooser-inner">
    <header class="chooser-title"><p class="kicker">Code Mortis / Landing previews</p><h1>Three ways <em>in.</em></h1><p>Open a direction and try its sample review, repository explorer, and setup guides.</p></header>
    <div class="choices">{directions.map(d => <a class="choice" href={`/mockups/${d.slug}/`}><div class="thumb">{previews[`../../components/mockups/previews/${d.slug}.webp`] && <img src={previews[`../../components/mockups/previews/${d.slug}.webp`]} width="800" height="500" alt={`${d.name} desktop landing preview`}/>}</div><p class="kicker">{d.angle}</p><h2>{d.name} <span aria-hidden="true">↗</span></h2><p>{d.description}</p><strong>{d.interaction} →</strong></a>)}</div>
  </div> : <>
    {field && <section class="print-cover"><div class="shell cover-inner">
      <div class="print-art" aria-hidden="true"><img src={ravenFlight.src} alt="" fetchpriority="high" width={ravenFlight.width} height={ravenFlight.height}/></div>
      <div class="print-heading" data-enter><p class="kicker">Open-source code review</p><h1>Catch the bug.<br/>Show the <i>proof.</i></h1><p>Mortis reviews your changes, points to the lines behind each finding, and checks the fix against the next commit.</p><div class="actions"><a class="primary" href="#finding">Inspect a finding <span>↓</span></a><a class="secondary" href="#setup">Choose a setup ↗</a></div></div>
      <div class="cover-index"><a href="/docs/cli/">Engine <span>CLI &amp; Python</span></a><a href="/docs/github-action/">Action <span>GitHub workflows</span></a><a href="/docs/app/">App <span>Self-hosted workspace</span></a></div>
    </div></section>}
    {bench && <EngineBench/>}
    {field && <><Finding/><Tour/><Setup/><Chapters chapter="security"/><Chapters chapter="agents"/></>}
    {desk && <ReviewDesk />}
    {bench && <><div class="bench-guide shell"><aside aria-label="Developer guide contents"><p class="kicker">Developer guide</p><a href="#finding">Review a change</a><a href="#agents">Connect an agent</a><a href="#controls">Configure Mortis</a></aside><div><Finding/><Chapters chapter="agents"/><Chapters chapter="controls"/></div></div><Tour/><Chapters chapter="security"/></>}
    {field && <Chapters chapter="controls"/>}
    {!desk && <Chapters chapter="questions"/>}
  </>}
</MarketingLayout>
