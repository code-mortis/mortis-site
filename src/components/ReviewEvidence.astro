---
import { captures, captureUrl } from './mockups/content';

const [label, description, width] = captures['review-finding'];
---

<figure class="review-evidence">
  <figcaption>
    <code>src/billing/reminders.py</code>
    <span>Lines 48–49</span>
  </figcaption>
  <pre aria-label="Suggested change to the invoice due date comparison"><code><span class="removed">- if invoice.due_date &lt; period_end:</span><span class="added">+ if invoice.due_date &lt;= period_end:</span><span>      queue_reminder(invoice)</span></code></pre>
  <button type="button" data-enlarge data-full={captureUrl('review-finding')} data-width={width}
    data-label={label} data-alt={description}>Open full review evidence <span aria-hidden="true">↗</span></button>
</figure>

<style>
  .review-evidence { background: #1f1f1f; color: #f5f4ef; border: 1px solid #51514e; border-radius: .625rem; }
  figcaption {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px;
    padding: 12px 16px; border-bottom: 1px solid #51514e; border-radius: .55rem .55rem 0 0;
    background: #303030; color: #e4e3de; font: 12px/1.5 var(--mono);
  }
  figcaption span { color: #c4c3bc; }
  pre { padding-block: 12px; font: 13px/1.65 var(--mono); white-space: pre-wrap; overflow-wrap: anywhere; }
  pre span { display: block; padding-inline: 16px; }
  .removed { color: #ffc3b8; background: #412a29; }
  .added { color: #bce6b6; background: #2b3528; }
  .review-evidence button[data-enlarge] {
    display: block; margin: 0 12px 10px; padding: 5px 4px; color: var(--orange);
    font-size: 14px; text-decoration: underline; text-underline-offset: 4px;
  }
  .review-evidence button[data-enlarge]:hover { color: #ffc1a9; }
</style>
