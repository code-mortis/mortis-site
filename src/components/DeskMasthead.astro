---
import logo from '../assets/orange/raven-orange-light.svg';

const path = Astro.url.pathname.replace(/\/$/, '');
const home = path === '' ? '' : '/';
---
<div class="desk-mast mast shell">
  <a class="brand" href="/" aria-label="Code Mortis home"><img src={logo.src} width="157" height="27" alt="Code Mortis" /></a>
  <nav aria-label="Main navigation">
    <a href={home + '#tour'}>Product</a>
    <a href={home + '#setup'}>Installation</a>
    <a href={home + '#agents'}>MCP</a>
    <a href="/comparison/" aria-current={path === '/comparison' ? 'page' : undefined}>Compare</a>
  </nav>
  <slot><a class="compare" href="/docs/">Docs <span aria-hidden="true">↗</span></a></slot>
</div>

<style>
  .desk-mast { width: calc(100% - clamp(44px,10vw,168px)); max-width: 1340px; margin-inline: auto; display: flex; align-items: center; min-height: 72px; gap: 45px; color: #202128; font: 550 14px/1.5 "Mortis Inter", Arial, sans-serif; }
  .desk-mast a { color: inherit; text-decoration: none; }
  .desk-mast a:hover, .desk-mast [aria-current] { text-decoration: underline; text-underline-offset: 5px; }
  .brand img { width: 170px; height: auto; display: block; }
  nav { display: flex; gap: 30px; margin-inline: auto; }
  .compare { padding: 7px 15px; border: 1px solid #d3d5d4; border-radius: 22px; }
  @media(max-width:960px) { .desk-mast { gap: 24px; } nav { gap: 20px; } }
  @media(max-width:740px) {
    .desk-mast { width: calc(100% - 36px); min-height: 60px; gap: 14px; }
    .brand { margin-right: auto; }
    .brand img { width: 133px; }
    nav { display: none; }
    .compare { font-size: 12px; }
  }
</style>
