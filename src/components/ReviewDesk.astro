---
import NightWatchHero from './review-desk/NightWatchHero.astro';
import ReviewEvidence from './ReviewEvidence.astro';
import Tour from './review-desk/Tour.astro';
import Chapters from './review-desk/Chapters.astro';
import Finding from './review-desk/Finding.astro';
import Setup from './review-desk/Setup.astro';
---

<NightWatchHero />

<!-- Keep bookmarks from the original homepage pointing to the corresponding sections. -->
<div id="features"><Tour lead /></div>
<Chapters chapter="agents" />
<Chapters chapter="security" />
<div id="workflow">
  <div id="example-finding">
    <Finding><ReviewEvidence slot="evidence" /></Finding>
  </div>
</div>
<div id="inside-the-engine">
  <div id="engine"></div>
  <div id="engine-features-title"></div>
  <div id="install"></div>
  <div id="get-started"></div>
  <Setup />
</div>
<div class="review-settings-band">
  <Chapters chapter="controls" />
</div>
<Chapters chapter="questions" />
